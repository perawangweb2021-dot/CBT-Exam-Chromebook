{
  "manifest_version": 3,
  "name": "CBT EXAM BROWSER - SMPN 1 TUALANG",
  "short_name": "CBT Exam",
  "version": "1.0.2",
  "description": "CBT Exam Browser SMP Negeri 1 Tualang untuk Chromebook Pendidikan (Mode Kiosk & Pengawas).",
  "icons": {
    "16": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  },
  "action": {
    "default_title": "Buka CBT Exam Browser",
    "default_icon": "icons/logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_blocker.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "system.display",
    "power",
    "audio"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "kiosk_enabled": true,
  "kiosk_only": false
}
